{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pidster/ai-project-setup/schemas/vendor-capability.schema.json",
  "title": "Vendor Capability",
  "description": "Declarative capability metadata for a target AI-tool vendor.",
  "type": "object",
  "required": ["vendor", "last_reviewed", "confidence", "sources", "supports"],
  "additionalProperties": true,
  "properties": {
    "vendor": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "confidence": {
      "type": "string",
      "enum": ["verified", "provisional", "unknown"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "supports": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "string"]
      }
    },
    "preferred_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
